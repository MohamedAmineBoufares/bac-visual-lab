{
  "name": "bac-visual-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive maths and physics simulations for Tunisian Bac students, in French, English and Arabic.",
  "keywords": [
    "bac",
    "education",
    "maths",
    "physics",
    "react",
    "simulation",
    "tunisia"
  ],
  "homepage": "https://github.com/MohamedAmineBoufares/bac-visual-lab#readme",
  "bugs": {
    "url": "https://github.com/MohamedAmineBoufares/bac-visual-lab/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Mohamed Amine Boufares",
    "url": "https://www.linkedin.com/in/mohamed-amine-boufares/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MohamedAmineBoufares/bac-visual-lab.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-arabic": "^5.3.0",
    "@fontsource-variable/readex-pro": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-router": "^1.170.46",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "katex": "^0.19.1",
    "lucide-react": "^1.71.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@rolldown/plugin-babel": "^0.3.1",
    "@tanstack/router-plugin": "^1.169.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@12.18.0"
}
